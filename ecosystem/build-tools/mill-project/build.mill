// Mill: a build tool where the build is plain Scala code and every task is a cached method.
//
//   cd ecosystem/build-tools/mill-project
//   ./mill core.compile          # ./mill is the bootstrap script: it downloads Mill itself
//   ./mill core.test
//   ./mill app.run
//   ./mill app.hello             # the custom task below
//   ./mill -w core.test          # watch mode: re-run on every change
//   ./mill show core.mvnDeps     # inspect a task's value
//   ./mill resolve __            # list every task
//   ./mill clean
//
// Layout differs from sbt: sources live in <module>/src, tests in <module>/test/src.
// Mill 1.x also accepts a declarative YAML build (build.mill.yaml / package.mill.yaml), e.g.
//   extends: ScalaModule
//   scalaVersion: 3.9.0
//   mvnDeps: [org.typelevel::cats-core:2.13.0]
// The programmable form below is what you need once you write custom tasks.
// The Mill version is pinned in .mill-version.
package build

import mill.*, scalalib.*

trait Common extends ScalaModule {
  def scalaVersion = "3.9.0"
  def scalacOptions = Seq("-deprecation", "-feature")
}

object core extends Common {
  def mvnDeps = Seq(mvn"org.typelevel::cats-core:2.13.0")

  object test extends ScalaTests, TestModule.Munit {
    def mvnDeps = Seq(mvn"org.scalameta::munit:1.3.6")
  }
}

object app extends Common {
  def moduleDeps = Seq(core)

  // A custom task: ./mill app.hello
  def hello = Task { println(s"Hello from Mill, Scala ${scalaVersion()}") }
}
